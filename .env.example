# Copie para .env e preencha. Nunca commite o .env.

# --- Telegram ---
# Token do bot, gerado pelo @BotFather
TELEGRAM_TOKEN=
# Segredo que compoe a URL do webhook (/webhook/<segredo>). Use algo longo e aleatorio,
# ex: python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=

# --- Spotify (https://developer.spotify.com/dashboard) ---
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
# Precisa estar cadastrada como Redirect URI no dashboard do Spotify
SPOTIPY_REDIRECT_URI=https://SEU-APP.onrender.com/callback
# Gerado uma unica vez acessando GET /login e autorizando (veja o README)
SPOTIFY_REFRESH_TOKEN=

# --- setlist.fm (https://api.setlist.fm/docs/1.0/index.html) ---
SETLIST_KEY=

# --- OpenAI ---
OPENAI_API_KEY=
